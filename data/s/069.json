che","",[[["إِنَّ","P","ACC|FAM:إِنّ",4],["ا","N","PRON|SUFF|1P",-1]],[["لَمَّا","N","T",70]],[["طَغَا","V","PERF|VF:1|3MS",734]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["مَآءُ","N","M|NOM",177]],[["حَمَلْ","V","PERF|VF:1|1P",269],["نَٰ","N","PRON|SUFF|1P",-1],["كُمْ","N","PRON|SUFF|2MP",-1]],[["فِى","P","P",3]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["جَارِيَةِ","N","ACT_PCPL|VF:1|F|GEN",2069]]]],["afin d'en faire pour vous un rappel que toute oreille fidèle conserve","",[[["لِ","P","PRP|PREF|LEM:ل",-1],["نَجْعَلَ","V","IMPF|VF:1|1P|MOOD:SUBJ",30],["هَا","N","PRON|SUFF|3FS",-1]],[["لَ","P","P|PREF|LEM:ل",-1],["كُمْ","N","PRON|2MP",-1]],[["تَذْكِرَةً","N","VN|VF:2|F|INDEF|ACC",924]],[["وَ","P","CONJ|PREF|LEM:و",-1],["تَعِيَ","V","IMPF|VF:1|3FS|MOOD:SUBJ",4439],["هَآ","N","PRON|SUFF|3FS",-1]],[["أُذُنٌ","N","F|INDEF|NOM",516]],[["وَٰعِيَةٌ","N","ACT_PCPL|VF:1|F|INDEF|NOM|ADJ",4440]]]],["Puis, quand d'un seul souffle, on soufflera dans la Trompe","",[[["فَ","P","REM|PREF|LEM:ف",-1],["إِذَا","N","T",23]],[["نُفِخَ","V","PERF|VF:1|PASS|3MS",508]],[["فِى","P","P",3]],[["ٱل","P","DET|PREF|LEM:ال",-1],["صُّورِ","N","M|GEN",838]],[["نَفْخَةٌ","N","F|INDEF|NOM",4441]],[["وَٰحِدَةٌ","N","F|INDEF|NOM|ADJ",348]]]],["et que la terre et les montagnes seront soulevées puis tassées d'un seul coup","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["حُمِلَتِ","V","PERF|VF:1|PASS|3FS",269]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["أَرْضُ","N","F|NOM",21]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["جِبَالُ","N","MP|NOM",291]],[["فَ","P","CONJ|PREF|LEM:ف",-1],["دُكَّ","V","PERF|VF:1|PASS|3FD",2773],["تَا","N","PRON|SUFF|3FD",-1]],[["دَكَّةً","N","F|INDEF|ACC",4442]],[["وَٰحِدَةً","N","F|INDEF|ACC|ADJ",348]]]],["ce jour-là alors, l'Evénement se produira","",[[["فَ","P","RSLT|PREF|LEM:ف",-1],["يَوْمَ","N","T",19],["ئِذٍ","N","T",35]],[["وَقَعَتِ","V","PERF|VF:1|3FS",718]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["وَاقِعَةُ","N","ACT_PCPL|VF:1|F|NOM",2754]]]],["et le ciel se fendra et sera fragi