{"n":100,"v":[["Par les coursiers qui halètent","",[[["وَ","P","P|PREF|LEM:و",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["عَٰدِيَٰتِ","N","ACT_PCPL|VF:1|FP|GEN",4730]],[["ضَبْحًا","N","M|INDEF|ACC",4731]]]],["qui font jaillir des étincelles","",[[["فَ","P","CONJ|PREF|LEM:ف",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["مُورِيَٰتِ","N","ACT_PCPL|VF:4|FP|GEN",4732]],[["قَدْحًا","N","M|INDEF|ACC",4733]]]],["qui attaquent au matin","",[[["فَ","P","CONJ|PREF|LEM:ف",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["مُغِيرَٰتِ","N","ACT_PCPL|VF:4|FP|GEN",4734]],[["صُبْحًا","N","T|M|INDEF|ACC",1380]]]],["et font ainsi voler la poussière","",[[["فَ","P","CONJ|PREF|LEM:ف",-1],["أَثَرْ","V","PERF|VF:4|3FP",1249],["نَ","N","PRON|SUFF|3FP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["هِۦ","N","PRON|3MS",-1]],[["نَقْعًا","N","M|INDEF|ACC",4735]]]],["et pénètrent au centre de la troupe ennemie","",[[["فَ","P","CONJ|PREF|LEM:ف",-1],["وَسَطْ","V","PERF|VF:1|3FP",4736],["نَ","N","PRON|SUFF|3FP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["هِۦ","N","PRON|3MS",-1]],[["جَمْعًا","N","M|INDEF|ACC",672]]]],["L'homme est, certes, ingrat envers son Seigneur","",[[["إِنَّ","P","ACC|FAM:إِنّ",4]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["إِنسَٰنَ","N","M|ACC",155]],[["لِ","P","P|PREF|LEM:ل",-1],["رَبِّ","N","M|GEN",11],["هِۦ","N","PRON|SUFF|3MS",-1]],[["لَ","P","EMPH|PREF|LEM:ل",-1],["كَنُودٌ","N","MS|INDEF|NOM",4737]]]],["et pourtant, il est certes, témoin de cela","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["إِنَّ","P","ACC|FAM:إِنّ",4],["هُۥ","N","PRON|SUFF|3MS",-1]],[["عَلَىٰ","P","P",8]],[["ذَٰ","N","DEM|MS",10],["لِ","P","DIST|SUFF|LEM:ل",-1],["كَ","P","ADDR|SUFF|M",-1]],[["لَ","P","EMPH|PREF|LEM:ل",-1],["شَهِيدٌ","N","MS|INDEF|NOM",198]]]],["et pour l'amour des richesses il est certes ardent","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["إِنَّ","P","ACC|FAM:إِنّ",4],["هُۥ","N","PRON|SUFF|3MS",-1]],[["لِ","P","P|PREF|LEM:ل",-1],["حُبِّ","N","M|GEN",871]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["خَيْرِ","N","MS|GEN",58]],[["لَ","P","EMPH|PREF|LEM:ل",-1],["شَدِيدٌ","N","MS|INDEF|NOM",201]]]],["Ne sait-il donc pas que lorsque ce qui est dans les tombes sera bouleversé","",[[["أَ","N","INTG|PREF|LEM:أ",-1],["فَ","P","SUP|PREF|LEM:ف",-1],["لَا","P","NEG",2]],[["يَعْلَمُ","V","IMPF|VF:1|3MS|MOOD:IND",25]],[["إِذَا","N","T",23]],[["بُعْثِرَ","V","PERF|VF:1|PASS|3MS",2795]],[["مَا","N","REL",6]],[["فِى","P","P",3]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["قُبُورِ","N","MP|GEN",1202]]]],["et que sera dévoilé ce qui est dans les poitrines","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["حُصِّلَ","V","PERF|VF:2|PASS|3MS",4738]],[["مَا","N","REL",6]],[["فِى","P","P",3]],[["ٱل","P","DET|PREF|LEM:ال",-1],["صُّدُورِ","N","MP|GEN",251]]]],["ce jour-là, certes, leur Seigneur sera Parfaitement Connaisseur d'eux","",[[["إِنَّ","P","ACC|FAM:إِنّ",4]],[["رَبَّ","N","M|ACC",11],["هُم","N","PRON|SUFF|3MP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["هِمْ","N","PRON|3MP",-1]],[["يَوْمَ","N","T",19],["ئِذٍ","N","T",35]],[["لَّ","P","EMPH|PREF|LEM:ل",-1],["خَبِيرٌۢ","N","MS|INDEF|NOM",246]]]]]}