َجْمُوعُونَ","N","PASS_PCPL|VF:1|MP|NOM",2405]],[["إِلَىٰ","P","P",14]],[["مِيقَٰتِ","N","M|GEN",947]],[["يَوْمٍ","N","M|INDEF|GEN",19]],[["مَّعْلُومٍ","N","PASS_PCPL|VF:1|M|INDEF|GEN",787]]]],["Et puis, vous, les égarés, qui traitiez (la Résurrection) de mensonge","Тогда вы, о заблудшие, считающие лжецами посланников",[[["ثُمَّ","P","CONJ",31]],[["إِنَّ","P","ACC|FAM:إِنّ",4],["كُمْ","N","PRON|SUFF|2MP",-1]],[["أَيُّ","N","ACC",51],["هَا","P","ATT|SUFF|LEM:ه",-1]],[["ٱل","P","DET|PREF|LEM:ال",-1],["ضَّآلُّونَ","N","ACT_PCPL|VF:1|MP|NOM",623]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["مُكَذِّبُونَ","N","ACT_PCPL|VF:2|MP|NOM",479]]]],["vous mangerez certainement d'un arbre de Zaqqûm","непременно вкусите от дерева заккум",[[["لَ","P","EMPH|PREF|LEM:ل",-1],["ءَاكِلُونَ","N","ACT_PCPL|VF:1|MP|NOM",2019]],[["مِن","P","P",0]],[["شَجَرٍ","N","M|INDEF|GEN",1101]],[["مِّن","P","P",0]],[["زَقُّومٍ","N","PN|M|INDEF|GEN",2052]]]],["vous vous en remplirez le ventre","Вы будете набивать ими животы",[[["فَ","P","REM|PREF|LEM:ف",-1],["مَالِـُٔونَ","N","ACT_PCPL|VF:1|MP|NOM",2683]],[["مِنْ","P","P",0],["هَا","N","PRON|SUFF|3FS",-1]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["بُطُونَ","N","MP|ACC",551]]]],["puis vous boirez par-dessus cela de l'eau bouillante","и запивать их кипятком",[[["فَ","P","CONJ|PREF|LEM:ف",-1],["شَٰرِبُونَ","N","ACT_PCPL|VF:1|MP|NOM",1397]],[["عَلَيْ","P","P",8],["هِ","N","PRON|SUFF|3MS",-1]],[["مِنَ","P","P",0]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["حَمِيمِ","N","MS|GEN",498]]]],["vous en boirez comme boivent les chameaux assoiffés","как пьют больные верблюды, которые не могут спастись от жажды»",[[["فَ","P","CONJ|PREF|LEM:ف",-1],["شَٰرِبُونَ","N","ACT_PCPL|VF:1|MP|NOM",1397]],[["شُرْبَ","N","M|ACC",4330]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["هِيمِ","N","M|GEN",4331]]]],["Voilà le repas d'accueil qui leur sera servi, au jour de la Rétribution","Таким для них будет угощение в День воздаяния",[[["هَٰ","P","ATT|PREF|LEM:ه",-1],["ذَا","N","DEM|MS",10]],[["نُزُلُ","N","NOM",965