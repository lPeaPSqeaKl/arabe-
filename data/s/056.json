380]],[["أَنتُم","N","PRON|2MP",-1]],[["مُّدْهِنُونَ","N","ACT_PCPL|VF:4|MP|NOM",4342]]]],["Et est-ce pour vous [une façon d'être reconnaissant] à votre subsistance que de traiter (le Coran) de mensonge","и делаете ваш удел тем, что считаете ложью истину",[[["وَ","P","CONJ|PREF|LEM:و",-1],["تَجْعَلُ","V","IMPF|VF:1|2MP|MOOD:IND",30],["ونَ","N","PRON|SUFF|2MP",-1]],[["رِزْقَ","N","M|ACC",202],["كُمْ","N","PRON|SUFF|2MP",-1]],[["أَنَّ","P","ACC|FAM:إِنّ",27],["كُمْ","N","PRON|SUFF|2MP",-1]],[["تُكَذِّبُ","V","IMPF|VF:2|2MP|MOOD:IND",59],["ونَ","N","PRON|SUFF|2MP",-1]]]],["Lorsque le souffle de la vie remonte à la gorge (d'un moribond)","А когда душа подступает к горлу",[[["فَ","P","REM|PREF|LEM:ف",-1],["لَوْلَآ","P","EXH",143]],[["إِذَا","N","T",23]],[["بَلَغَتِ","V","PERF|VF:1|3FS",278]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["حُلْقُومَ","N","M|ACC",4343]]]],["et qu'à ce moment là vous regardez","и вы смотрите на умирающего",[[["وَ","P","CONJ|PREF|LEM:و",-1],["أَنتُمْ","N","PRON|2MP",-1]],[["حِينَئِذٍ","N","T",315]],[["تَنظُرُ","V","IMPF|VF:1|2MP|MOOD:IND",117],["ونَ","N","PRON|SUFF|2MP",-1]]]],["et que Nous sommes plus proche de lui que vous [qui l'entourez] mais vous ne [le] voyez point","Мы находимся ближе вас к нему, хотя вы не видите этого",[[["وَ","P","CONJ|PREF|LEM:و",-1],["نَحْنُ","N","PRON|1P",-1]],[["أَقْرَبُ","N","MS|NOM",506]],[["إِلَيْ","P","P",14],["هِ","N","PRON|SUFF|3MS",-1]],[["مِن","P","P",0],["كُمْ","N","PRON|SUFF|2MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["لَٰكِن","P","AMD",167]],[["لَّا","P","NEG",2]],[["تُبْصِرُ","V","IMPF|VF:4|2MP|MOOD:IND",360],["ونَ","N","PRON|SUFF|2MP",-1]]]],["Pourquoi donc, si vous croyez que vous n'avez pas de compte à rendre","Почему же вы, если вы действительно не получите воздаяние",[[["فَ","P","REM|PREF|LEM:ف",-1],["لَوْلَآ","P","EXH",143]],[["إِن","P","COND",15]],[["كُن","V","PERF|VF:1|FAM:كَان|2MP",9],["تُمْ","N","PRON|SUFF|2MP",-1]],[["غَيْرَ","N","M|ACC",71]],[["مَدِينِينَ","N","PASS_PCPL|VF:1|MP|GEN",2682]]]],["ne la faites-vous pas revenir [cette âme], si vous êtes véridiques","не вернете ее, если вы говорите правду",[[["تَرْجِعُ","V","IMPF|VF:1|2MP|MOOD:IND",131],["ونَ","N","PRON|SUFF|2MP",-1],["هَآ","N","PRON|SUFF|3FS",-1]],[["إِن","P","COND",15]],[["كُن","V","PERF|VF:1|FAM:كَان|2MP",9],["تُمْ","N","PRON|SUFF|2MP",-1]],[["صَٰدِقِينَ","N","ACT_PCPL|VF:1|MP|ACC",186]]]],["Si celui-ci est du nombre des rapprochés (d'Allah)","Если он будет одним из приближенных",[[["فَ","P","REM|PREF|LEM:ف",-1],["أَمَّآ","P","EXL",204]],[["إِن","P","COND",15]],[["كَانَ","V","PERF|VF:1|FAM:كَان|3MS",9]],[["مِنَ","P","P",0]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["مُقَرَّبِينَ","N","PASS_PCPL|VF:2|MP|GEN",958]]]],["alors (il aura) du repos, de la grâce et un Jardin de délices","то обретет покой (или радость; или милость), удел (или базилик) и Сад блаженства",[[["فَ","P","REM|PREF|LEM:ف",-1],["رَوْحٌ","N","M|INDEF|NOM",1948]],[["وَ","P","CONJ|PREF|LEM:و",-1],["رَيْحَانٌ","N","M|INDEF|NOM",2748]],[["وَ","P","CONJ|PREF|LEM:و",-1],["جَنَّتُ","N","FP|NOM",72]],[["نَعِيمٍ","N","M|INDEF|GEN",562]]]],["Et s'il est du nombre des gens de la droite","Если он будет одним из тех, кто по правую сторону",[[["وَ","P","CONJ|PREF|LEM:و",-1],["أَمَّآ","P","EXL",204]],[["إِن","P","COND",15]],[["كَانَ","V","PERF|VF:1|FAM:كَان|3MS",9]],[["مِنْ","P","P",0]],[["أَصْحَٰبِ","N","MP|GEN",132]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["يَمِينِ","N","M|GEN",171]]]],["il sera [accueilli par ces mots]: «Paix à toi» de la part des gens de la droite","то ему скажут: «Мир тебе! Ты являешься одним из тех, кто на правой стороне»",[[["فَ","P","REM|PREF|LEM:ف",-1],["سَلَٰمٌ","N","M|INDEF|NOM",264]],[["لَّ","P","P|PREF|LEM:ل",-1],["كَ","N","PRON|2MS",-1]],[["مِنْ","P","P",0]],[["أَصْحَٰبِ","N","MP|GEN",132]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["يَمِينِ","N","M|GEN",171]]]],["Et s'il est de ceux qui avaient traité de mensonge (la résurrection) et s'étaient égarés","Если же он будет одним из заблудших, считавших лжецами посланников",[[["وَ","P","CONJ|PREF|LEM:و",-1],["أَمَّآ","P","EXL",204]],[["إِن","P","COND",15]],[["كَانَ","V","PERF|VF:1|FAM:كَان|3MS",9]],[["مِنَ","P","P",0]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["مُكَذِّبِينَ","N","ACT_PCPL|VF:2|MP|GEN",479]],[["ٱل","P","DET|PREF|LEM:ال",-1],["ضَّآلِّينَ","N","ACT_PCPL|VF:1|MP|GEN|ADJ",623]]]],["alors, il sera installé dans une eau bouillante","то угощением для него будет кипяток",[[["فَ","P","REM|PREF|LEM:ف",-1],["نُزُلٌ","N","INDEF|NOM",965]],[["مِّنْ","P","P",0]],[["حَمِيمٍ","N","MS|INDEF|GEN",498]]]],["et il brûlera dans la Fournaise","и он будет гореть в Аду",[[["وَ","P","CONJ|PREF|LEM:و",-1],["تَصْلِيَةُ","N","VN|VF:2|F|NOM",4344]],[["جَحِيمٍ","N","F|INDEF|GEN",398]]]],["C'est cela la pleine certitude","Это и есть истина",[[["إِنَّ","P","ACC|FAM:إِنّ",4]],[["هَٰ","P","ATT|PREF|LEM:ه",-1],["ذَا","N","DEM|MS",10]],[["لَ","P","EMPH|PREF|LEM:ل",-1],["هُوَ","N","PRON|3MS",-1]],[["حَقُّ","N","M|NOM",47]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["يَقِينِ","N","MS|GEN|ADJ",973]]]],["Glorifie donc le nom de ton Seigneur, le Très Grand","Прославляй же имя Господа твоего Великого",[[["فَ","P","REM|PREF|LEM:ف",-1],["سَبِّحْ","V","IMPV|VF:2|2MS",258]],[["بِ","P","P|PREF|LEM:ب",-1],["ٱسْمِ","N","M|GEN",284]],[["رَبِّ","N","M|GEN",11],["كَ","N","PRON|SUFF|2MS",-1]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["عَظِيمِ","N","MS|GEN|ADJ",98]]]]]}