,9],["تُمْ","N","PRON|SUFF|2MP",-1]],[["تَكْفُرُ","V","IMPF|VF:1|2MP|MOOD:IND",37],["ونَ","N","PRON|SUFF|2MP",-1]]]],["Endure (Muhammad) donc, comme ont enduré les messagers doués de fermeté; et ne te montre pas trop pressé de les voir subir [leur châtiment]. Le jour où ils verront ce qui leur est promis, il leur semblera qu'ils n'étaient restés [sur terre] qu'une heure d'un jour. Voilà une communication. Qui sera donc anéanti sinon les gens pervers","Терпи же, как терпели твердые духом посланники, и не торопи Меня с наказанием для них. В тот день, когда они увидят то, что им обещано, им покажется, что они пробыли на земле всего лишь час дня. Таково послание! Разве будет погублен кто-либо, кроме нечестивых людей",[[["فَ","P","REM|PREF|LEM:ف",-1],["ٱصْبِرْ","V","IMPV|VF:1|2MS",190]],[["كَ","P","P|PREF|LEM:ك",-1],["مَا","P","SUB",12]],[["صَبَرَ","V","PERF|VF:1|3MS",190]],[["أُو۟لُوا۟","N","MP|NOM",68]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["عَزْمِ","N","M|GEN",1306]],[["مِنَ","P","P",0]],[["ٱل","P","DET|PREF|LEM:ال",-1],["رُّسُلِ","N","MP|GEN",32]],[["وَ","P","CONJ|PREF|LEM:و",-1],["لَا","P","NEG",2]],[["تَسْتَعْجِل","V","IMPF|VF:10|2MS|MOOD:JUS",512]],[["لَّ","P","P|PREF|LEM:ل",-1],["هُمْ","N","PRON|3MP",-1]],[["كَأَنَّ","P","ACC|FAM:إِنّ",344],["هُمْ","N","PRON|SUFF|3MP",-1]],[["يَوْمَ","N","M|ACC",19]],[["يَرَ","V","IMPF|VF:1|3MP|MOOD:IND",43],["وْنَ","N","PRON|SUFF|3MP",-1]],[["مَا","N","REL",6]],[["يُوعَدُ","V","IMPF|VF:1|PASS|3MP|MOOD:IND",164],["ونَ","N","PRON|SUFF|3MP",-1]],[["لَمْ","P","NEG",29]],[["يَلْبَثُ","V","IMPF|VF:1|3MP|MOOD:JUS",356],["وٓا۟","N","PRON|SUFF|3MP",-1]],[["إِلَّا","P","RES",16]],[["سَاعَةً","N","F|INDEF|ACC",235]],[["مِّن","P","P",0]],[["نَّهَارٍۭ","N","M|INDEF|GEN",197]],[["بَلَٰغٌ","N","M|INDEF|NOM",611]],[["فَ","P","REM|PREF|LEM:ف",-1],["هَلْ","P","INTG",108]],[["يُهْلَكُ","V","IMPF|VF:4|PASS|3MS|MOOD:IND",218]],[["إِلَّا","P","RES",16]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["قَوْمُ","N","M|NOM",24]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["فَٰس