],["هُمْ","N","PRON|SUFF|3MP",-1]],[["أَحْسَنَ","N","MS|ACC",309]],[["مَا","N","REL",6]],[["عَمِلُ","V","PERF|VF:1|3MP",41],["وا۟","N","PRON|SUFF|3MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["نَتَجَاوَزُ","V","IMPF|VF:6|1P|MOOD:IND",4157]],[["عَن","P","P",20]],[["سَيِّـَٔاتِ","N","FP|GEN",191],["هِمْ","N","PRON|SUFF|3MP",-1]],[["فِىٓ","P","P",3]],[["أَصْحَٰبِ","N","MP|GEN",132]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["جَنَّةِ","N","PN|F|GEN",72]],[["وَعْدَ","N","M|ACC",231]],[["ٱل","P","DET|PREF|LEM:ال",-1],["صِّدْقِ","N","M|GEN",648]],[["ٱلَّذِى","N","REL|MS",7]],[["كَانُ","V","PERF|VF:1|FAM:كَان|3MP",9],["وا۟","N","PRON|SUFF|3MP",-1]],[["يُوعَدُ","V","IMPF|VF:1|PASS|3MP|MOOD:IND",164],["ونَ","N","PRON|SUFF|3MP",-1]]]],["Quant à celui qui dit à ses père et mère: «Fi de vous deux! Me promettez-vous qu'on me fera sortir de terre alors que des générations avant moi ont passé?» Et les deux, implorant le secours d'Allah, [lui dirent]: «Malheur à toi! Crois. Car la promesse d'Allah est véridique». Mais il (répond): «Ce ne sont que des contes d'Anciens»","А есть такой, который говорит своим родителям: «Тьфу вам! Неужели вы угрожаете мне тем, что меня вытащат из могилы, в то время как до меня уже прошло много поколений?». Они просят Аллаха о помощи: «Горе тебе! Уверуй, ведь обещание Аллаха истинно!». Он же говорит: «Это - всего лишь легенды древних народов»",[[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱلَّذِى","N","REL|MS",7]],[["قَالَ","V","PERF|VF:1|3MS",5]],[["لِ","P","P|PREF|LEM:ل",-1],["وَٰلِدَيْ","N","MD|GEN",851],["هِ","N","PRON|SUFF|3MS",-1]],[["أُفٍّ","N","NV|IMPF",1974]],[["لَّ","P","P|PREF|LEM:ل",-1],["كُمَآ","N","PRON|2D",-1]],[["أَ","N","INTG|PREF|LEM:أ",-1],["تَعِدَ","V","IMPF|VF:1|3FD|MOOD:IND",164],["انِ","N","PRON|SUFF|3D",-1],["نِىٓ","N","PRON|SUFF|1S",-1]],[["أَنْ","P","SUB",17]],[["أُخْرَجَ","V","IMPF|VF:4|PASS|1S|MOOD:SUBJ",105]],[["وَ","P","CONJ|PREF|LEM:و",-1],["قَدْ","P","CERT",22]],[["خَلَتِ","V","PERF|VF:1|3FS",407]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["قُرُون