]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱل","P","DET|PREF|LEM:ال",-1],["شَّهَٰدَةِ","N","F|GEN",399]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["عَزِيزُ","N","MS|NOM|ADJ",104]],[["ٱل","P","DET|PREF|LEM:ال",-1],["رَّحِيمُ","N","MS|NOM|ADJ",94]]]],["qui a bien fait tout ce qu'Il a créé. Et Il a commencé la création de l'homme à partir de l'argile","",[[["ٱلَّذِىٓ","N","REL|MS",7]],[["أَحْسَنَ","V","PERF|VF:4|3MS",472]],[["كُلَّ","N","M|ACC",28]],[["شَىْءٍ","N","M|INDEF|GEN",38]],[["خَلَقَ","V","PERF|VF:1|3MS",56],["هُۥ","N","PRON|SUFF|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["بَدَأَ","V","PERF|VF:1|3MS",726]],[["خَلْقَ","N","M|ACC",212]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["إِنسَٰنِ","N","M|GEN",155]],[["مِن","P","P",0]],[["طِينٍ","N","M|INDEF|GEN",709]]]],["puis Il tira sa descendance d'une goutte d'eau vile [le sperme]","",[[["ثُمَّ","P","CONJ",31]],[["جَعَلَ","V","PERF|VF:1|3MS",30]],[["نَسْلَ","N","M|ACC",2131],["هُۥ","N","PRON|SUFF|3MS",-1]],[["مِن","P","P",0]],[["سُلَٰلَةٍ","N","F|INDEF|GEN",2583]],[["مِّن","P","P",0]],[["مَّآءٍ","N","M|INDEF|GEN",177]],[["مَّهِينٍ","N","MS|INDEF|GEN|ADJ",1657]]]],["puis Il lui donna sa forme parfaite et lui insuffla de Son Esprit. Et Il vous a assigné l'ouïe, les yeux et le cœur. Que vous êtes peu reconnaissants","",[[["ثُمَّ","P","CONJ",31]],[["سَوَّىٰ","V","PERF|VF:2|3MS",657],["هُ","N","PRON|SUFF|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["نَفَخَ","V","PERF|VF:1|3MS",508]],[["فِي","P","P",3],["هِ","N","PRON|SUFF|3MS",-1]],[["مِن","P","P",0]],[["رُّوحِ","N","M|GEN",470],["هِۦ","N","PRON|SUFF|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["جَعَلَ","V","PERF|VF:1|3MS",30]],[["لَ","P","P|PREF|LEM:ل",-1],["كُمُ","N","PRON|2MP",-1]],[["ٱل","P","DET|PREF|LEM:ال",-1],["سَّمْعَ","N","M|ACC",445]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["أَبْصَٰرَ","N","MP|ACC",232]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["أَفْـِٔدَةَ","N","MP|ACC",588]],[["قَلِيلًا","N","MS|INDEF|ACC|ADJ",160]],[["مَّا","N","REL",6]],[["تَشْكُرُ","V","IMPF|VF:1|2MP|MOOD:IND",238],["ونَ","N","PRON|SUFF|2MP",-1]]]],["Et ils disent: «Quand nous serons perdus dans la terre [sous forme de poussière], redeviendrons-nous une création nouvelle?» En outre, ils ne croient pas en la rencontre avec leur Seigneur","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["قَالُ","V","PERF|VF:1|3MP",5],["وٓا۟","N","PRON|SUFF|3MP",-1]],[["أَ","N","INTG|PREF|LEM:أ",-1],["ءِذَا","N","T",23]],[["ضَلَلْ","V","PERF|VF:1|1P",210],["نَا","N","PRON|SUFF|1P",-1]],[["فِى","P","P",3]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["أَرْضِ","N","F|GEN",21]],[["أَ","N","INTG|PREF|LEM:أ",-1],["ءِنَّ","P","ACC|FAM:إِنّ",4],["ا","N","PRON|SUFF|1P",-1]],[["لَ","P","EMPH|PREF|LEM:ل",-1],["فِى","P","P",3]],[["خَلْقٍ","N","M|INDEF|GEN",212]],[["جَدِيدٍۭ","N","MS|INDEF|GEN|ADJ",994]],[["بَلْ","P","RET",88]],[["هُم","N","PRON|3MP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["لِقَآءِ","N","VN|VF:3|M|GEN",429]],[["رَبِّ","N","M|GEN",11],["هِمْ","N","PRON|SUFF|3MP",-1]],[["كَٰفِرُونَ","N","ACT_PCPL|VF:1|MP|NOM",67]]]],["Dis: «L'Ange de la mort qui est chargé de vous, vous fera mourir. Ensuite, vous serez ramenés vers Votre Seigneur»","",[[["قُلْ","V","IMPV|VF:1|2MS",5]],[["يَتَوَفَّىٰ","V","IMPF|VF:5|3MS|MOOD:SUBJ",425],["كُم","N","PRON|SUFF|2MP",-1]],[["مَّلَكُ","N","M|NOM",116]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["مَوْتِ","N","M|GEN",220]],[["ٱلَّذِى","N","REL|MS",7]],[["وُكِّلَ","V","PERF|VF:2|PASS|3MS",2287]],[["بِ","P","P|PREF|LEM:ب",-1],["كُمْ","N","PRON|2MP",-1]],[["ثُمَّ","P","CONJ",31]],[["إِلَىٰ","P","P",14]],[["رَبِّ","N","M|GEN",11],["كُمْ","N","PRON|SUFF|2MP",-1]],[["تُرْجَعُ","V","IMPF|VF:1|PASS|2MP|MOOD:IND",131],["ونَ","N","PRON|SUFF|2MP",-1]]]],["Si tu voyais alors les criminels [comparaître], têtes basses devant leur Seigneur! «Notre Seigneur, Nous avons vu et entendu, renvoie-nous donc afin que nous puissions faire du bien; nous croyons [maintenant] avec certitude»","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["لَوْ","P","COND",53]],[["تَرَىٰٓ","V