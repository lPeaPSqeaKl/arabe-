"ٱلَّذِينَ","N","REL|MP",7]],[["ءَامَنُ","V","PERF|VF:4|3MP",18],["وا۟","N","PRON|SUFF|3MP",-1]],[["ٱتَّقُ","V","IMPV|VF:8|2MP",62],["وا۟","N","PRON|SUFF|2MP",-1]],[["ٱللَّهَ","N","PN|ACC",1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ءَامِنُ","V","IMPV|VF:4|2MP",18],["وا۟","N","PRON|SUFF|2MP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["رَسُولِ","N","M|GEN",32],["هِۦ","N","PRON|SUFF|3MS",-1]],[["يُؤْتِ","V","IMPF|VF:4|3MS|MOOD:JUS",42],["كُمْ","N","PRON|SUFF|2MP",-1]],[["كِفْلَيْنِ","N","MD|NOM",1508]],[["مِن","P","P",0]],[["رَّحْمَتِ","N","F|GEN",96],["هِۦ","N","PRON|SUFF|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["يَجْعَل","V","IMPF|VF:1|3MS|MOOD:JUS",30]],[["لَّ","P","P|PREF|LEM:ل",-1],["كُمْ","N","PRON|2MP",-1]],[["نُورًا","N","M|INDEF|ACC",255]],[["تَمْشُ","V","IMPF|VF:1|2MP|MOOD:IND",467],["ونَ","N","PRON|SUFF|2MP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["هِۦ","N","PRON|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["يَغْفِرْ","V","IMPF|VF:1|3MS|MOOD:JUS",168]],[["لَ","P","P|PREF|LEM:ل",-1],["كُمْ","N","PRON|2MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱللَّهُ","N","PN|NOM",1]],[["غَفُورٌ","N","MS|INDEF|NOM|ADJ",111]],[["رَّحِيمٌ","N","MS|INDEF|NOM|ADJ",94]]]],["Cela afin que les gens du Livre sachent qu'ils ne peuvent en rien disposer de la grâce d'Allah et que la grâce est dans la main d'Allah. Il la donne à qui Il veut, et Allah est le Détenteur de la grâce immense","Аллах одарит вас для того, чтобы люди Писания знали, что они ничего не способны приобрести из милости Аллаха и что милость находится в Руке Аллаха, Который дарует ее тому, кому пожелает. Аллах обладает великой милостью",[[["لِّ","P","PRP|PREF|LEM:ل",-1],["ئَلَّا","P","NEG",2]],[["يَعْلَمَ","V","IMPF|VF:1|3MS|MOOD:SUBJ",25]],[["أَهْلُ","N","M|NOM",89]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["كِتَٰبِ","N","M|GEN",46]],[["أَ","P","SUB",17],["لَّا","P","NEG",2]],[["يَقْدِرُ","V","IMPF|VF:1|3MP|MOOD:IND",414],["ونَ","N","PRON|SUFF|3MP",-1]],[["عَلَىٰ","P","P",8]],[["شَىْءٍ","N","M|INDEF|GEN",38]],[["مِّن","P","P",0]],[["فَ