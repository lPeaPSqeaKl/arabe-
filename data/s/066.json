о неверующих жену Нуха (Ноя) и жену Лута (Лота). Обе были замужем за рабами из числа Наших праведных рабов. Они предали своих мужей, и те не спасли их от Аллаха. Им было сказано: «Войдите в Огонь вместе с теми, кто входит туда»",[[["ضَرَبَ","V","PERF|VF:1|3MS",203]],[["ٱللَّهُ","N","PN|NOM",1]],[["مَثَلًا","N","M|INDEF|ACC",114]],[["لِّ","P","P|PREF|LEM:ل",-1],["لَّذِينَ","N","REL|MP",7]],[["كَفَرُ","V","PERF|VF:1|3MP",37],["وا۟","N","PRON|SUFF|3MP",-1]],[["ٱمْرَأَتَ","N","F|ACC",403]],[["نُوحٍ","N","PN|M|GEN",257]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱمْرَأَتَ","N","F|ACC",403]],[["لُوطٍ","N","PN|GEN",393]],[["كَانَ","V","PERF|VF:1|FAM:كَان|3FD",9],["تَا","N","PRON|SUFF|3FD",-1]],[["تَحْتَ","N","LOC|ACC",215]],[["عَبْدَيْنِ","N","MD|GEN",83]],[["مِنْ","P","P",0]],[["عِبَادِ","N","MP|GEN",83],["نَا","N","PRON|SUFF|1P",-1]],[["صَٰلِحَيْنِ","N","ACT_PCPL|VF:1|MD|GEN|ADJ",147]],[["فَ","P","CONJ|PREF|LEM:ف",-1],["خَانَ","V","PERF|VF:1|3FD",1364],["تَا","N","PRON|SUFF|3FD",-1],["هُمَا","N","PRON|SUFF|3D",-1]],[["فَ","P","REM|PREF|LEM:ف",-1],["لَمْ","P","NEG",29]],[["يُغْنِيَ","V","IMPF|VF:4|3MD|MOOD:JUS",378],["ا","N","PRON|SUFF|3D",-1]],[["عَنْ","P","P",20],["هُمَا","N","PRON|SUFF|3D",-1]],[["مِنَ","P","P",0]],[["ٱللَّهِ","N","PN|GEN",1]],[["شَيْـًٔا","N","M|INDEF|ACC",38]],[["وَ","P","REM|PREF|LEM:و",-1],["قِيلَ","V","PERF|VF:1|PASS|3MS",5]],[["ٱدْخُلَ","V","IMPV|VF:1|2MD",138],["ا","N","PRON|SUFF|2D",-1]],[["ٱل","P","DET|PREF|LEM:ال",-1],["نَّارَ","N","F|ACC",74]],[["مَعَ","N","LOC|ACC",64]],[["ٱل","P","DET|PREF|LEM:ال",-1],["دَّٰخِلِينَ","N","ACT_PCPL|VF:1|MP|GEN",2259]]]],["et Allah a cité en parabole pour ceux qui croient, la femme de Pharaon, quand elle dit «Seigneur, construis-moi auprès de Toi une maison dans le Paradis, et sauve-moi de Pharaon et de son œuvre; et sauve-moi des gens injustes»","А в качестве примера о верующих Аллах привел жену Фараона. Вот она сказала: «Господи! Спаси меня от Фараона и его деяний! Возведи для меня дом в Раю возле Тебя и спаси меня от несправедливых людей!»",[[["وَ","P","CONJ|PREF|LEM:و",-1],["ضَرَبَ","V","PERF|VF:1|3MS",203]],[["ٱللَّهُ","N","PN|NOM",1]],[["مَثَلًا","N","M|INDEF|ACC",114]],[["لِّ","P","P|PREF|LEM:ل",-1],["لَّذِينَ","N","REL|MP",7]],[["ءَامَنُ","V","PERF|VF:4|3MP",18],["وا۟","N","PRON|SUFF|3MP",-1]],[["ٱمْرَأَتَ","N","F|ACC",403]],[["فِرْعَوْنَ","N","PN|M|GEN",146]],[["إِذْ","N","T",35]],[["قَالَتْ","V","PERF|VF:1|3FS",5]],[["رَبِّ","N","M|ACC",11],["","N","PRON|SUFF|1S",-1]],[["ٱبْنِ","V","IMPV|VF:1|2MS",784]],[["لِ","P","P|PREF|LEM:ل",-1],["ى","N","PRON|1S",-1]],[["عِندَ","N","LOC|ACC",55],["كَ","N","PRON|SUFF|2MS",-1]],[["بَيْتًا","N","M|INDEF|ACC",170]],[["فِى","P","P",3]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["جَنَّةِ","N","PN|F|GEN",72]],[["وَ","P","CONJ|PREF|LEM:و",-1],["نَجِّ","V","IMPV|VF:2|2MS",301],["نِى","N","PRON|SUFF|1S",-1]],[["مِن","P","P",0]],[["فِرْعَوْنَ","N","PN|M|GEN",146]],[["وَ","P","CONJ|PREF|LEM:و",-1],["عَمَلِ","N","M|GEN",158],["هِۦ","N","PRON|SUFF|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["نَجِّ","V","IMPV|VF:2|2MS",301],["نِى","N","PRON|SUFF|1S",-1]],[["مِنَ","P","P",0]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["قَوْمِ","N","M|GEN",24]],[["ٱل","P","DET|PREF|LEM:ال",-1],["ظَّٰلِمِينَ","N","ACT_PCPL|VF:1|MP|GEN|ADJ",86]]]],["De même, Marie, la fille d''Imran qui avait préservé sa virginité; Nous y insufflâmes alors de Notre Esprit. Elle avait déclaré véridiques les paroles de son Seigneur ainsi que Ses Livres: elle fut parmi les dévoués","А также Марьям (Марию), дочь Имрана, которая сберегла целомудрие, и Мы вдохнули в него (в вырез на ее одежде) от Нашего духа. Она уверовала в Слова своего Господа и Его Писания и была одной из покорных",[[["وَ","P","CONJ|PREF|LEM:و",-1],["مَرْيَمَ","N","PN|F|ACC",323]],[["ٱبْنَتَ","N","F|ACC",2643]],[["عِمْرَٰنَ","N","PN|GEN",1755]],[["ٱلَّتِىٓ","N","REL|FS",7]],[["أَحْصَنَتْ","V","PERF|VF:4|3FS",1311]],[["فَرْجَ","N","M|ACC",1004],["هَا","N","PRON|SUFF|3FS",-1]],[["فَ","P","CAUS|PREF|LEM:ف",-1],["نَفَخْ","V","PERF|VF:1|