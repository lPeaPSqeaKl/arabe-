 pour eux. Allah cependant, est Pardonneur et Miséricordieux","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["لَوْ","P","COND",53]],[["أَنَّ","P","ACC|FAM:إِنّ",27],["هُمْ","N","PRON|SUFF|3MP",-1]],[["صَبَرُ","V","PERF|VF:1|3MP",190],["وا۟","N","PRON|SUFF|3MP",-1]],[["حَتَّىٰ","P","P",77]],[["تَخْرُجَ","V","IMPF|VF:1|2MS|MOOD:SUBJ",209]],[["إِلَيْ","P","P",14],["هِمْ","N","PRON|SUFF|3MP",-1]],[["لَ","P","EMPH|PREF|LEM:ل",-1],["كَانَ","V","PERF|VF:1|FAM:كَان|3MS",9]],[["خَيْرًا","N","MS|INDEF|ACC",58]],[["لَّ","P","P|PREF|LEM:ل",-1],["هُمْ","N","PRON|3MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱللَّهُ","N","PN|NOM",1]],[["غَفُورٌ","N","MS|INDEF|NOM|ADJ",111]],[["رَّحِيمٌ","N","MS|INDEF|NOM|ADJ",94]]]],["O vous qui avez cru! Si un pervers vous apporte une nouvelle, voyez bien clair [de crainte] que par inadvertance vous ne portiez atteinte à des gens et que vous ne regrettiez par la suite ce que vous avez fait","",[[["يَٰٓ","P","VOC|PREF|LEM:ي",-1],["أَيُّ","N","ACC",51],["هَا","P","ATT|SUFF|LEM:ه",-1]],[["ٱلَّذِينَ","N","REL|MP",7]],[["ءَامَنُ","V","PERF|VF:4|3MP",18],["وٓا۟","N","PRON|SUFF|3MP",-1]],[["إِن","P","COND",15]],[["جَآءَ","V","PERF|VF:1|3MS",40],["كُمْ","N","PRON|SUFF|2MP",-1]],[["فَاسِقٌۢ","N","ACT_PCPL|VF:1|M|INDEF|NOM",299]],[["بِ","P","P|PREF|LEM:ب",-1],["نَبَإٍ","N","M|INDEF|GEN",366]],[["فَ","P","REM|PREF|LEM:ف",-1],["تَبَيَّنُ","V","IMPV|VF:5|2MP",519],["وٓا۟","N","PRON|SUFF|2MP",-1]],[["أَن","P","SUB",17]],[["تُصِيبُ","V","IMPF|VF:4|2MP|MOOD:SUBJ",175],["وا۟","N","PRON|SUFF|2MP",-1]],[["قَوْمًۢا","N","M|INDEF|ACC",24]],[["بِ","P","P|PREF|LEM:ب",-1],["جَهَٰلَةٍ","N","F|INDEF|GEN",1497]],[["فَ","P","REM|PREF|LEM:ف",-1],["تُصْبِحُ","V","IMPF|VF:4|FAM:كَان|2MP|MOOD:SUBJ",379],["وا۟","N","PRON|SUFF|2MP",-1]],[["عَلَىٰ","P","P",8]],[["مَا","N","REL",6]],[["فَعَلْ","V","PERF|VF:1|2MP",115],["تُمْ","N","PRON|SUFF|2MP",-1]],[["نَٰدِمِينَ","N","ACT_PCPL|VF:1|MP|ACC",1325]]]],["Et sachez que le Messager d'Allah est parmi vous. S'il vous obéissait dans maintes affaires, vous seriez en difficultés. Mais Allah vous a fait aimer la foi et l'a embellie dans vos cœurs et vous a fait détester la mécréance, la perversité et la désobéissance. Ceux-là sont les bien dirigés","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱعْلَمُ","V","IMPV|VF:1|2MP",25],["وٓا۟","N","PRON|SUFF|2MP",-1]],[["أَنَّ","P","ACC|FAM:إِنّ",27]],[["فِي","P","P",3],["كُمْ","N","PRON|SUFF|2MP",-1]],[["رَسُولَ","N","M|ACC",32]],[["ٱللَّهِ","N","PN|GEN",1]],[["لَوْ","P","COND",53]],[["يُطِيعُ","V","IMPF|VF:4|3MS|MOOD:IND",153],["كُمْ","N","PRON|SUFF|2MP",-1]],[["فِى","P","P",3]],[["كَثِيرٍ","N","MS|INDEF|GEN",178]],[["مِّنَ","P","P",0]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["أَمْرِ","N","M|GEN",63]],[["لَ","P","EMPH|PREF|LEM:ل",-1],["عَنِ","V","PERF|VF:1|2MP",1764],["تُّمْ","N","PRON|SUFF|2MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["لَٰكِنَّ","P","ACC|FAM:إِنّ",169]],[["ٱللَّهَ","N","PN|ACC",1]],[["حَبَّبَ","V","PERF|VF:2|3MS",4195]],[["إِلَيْ","P","P",14],["كُمُ","N","PRON|SUFF|2MP",-1]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["إِيمَٰنَ","N","VN|VF:4|M|ACC",243]],[["وَ","P","CONJ|PREF|LEM:و",-1],["زَيَّنَ","V","PERF|VF:2|3MS",402],["هُۥ","N","PRON|SUFF|3MS",-1]],[["فِى","P","P",3]],[["قُلُوبِ","N","FP|GEN",82],["كُمْ","N","PRON|SUFF|2MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["كَرَّهَ","V","PERF|VF:2|3MS",4196]],[["إِلَيْ","P","P",14],["كُمُ","N","PRON|SUFF|2MP",-1]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["كُفْرَ","N","M|ACC",302]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["فُسُوقَ","N","M|ACC",1459]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["عِصْيَانَ","N","M|ACC",4197]],[["أُو۟لَٰٓئِ","N","DEM|P",10],["كَ","P","ADDR|SUFF|M",-1]],[["هُمُ","N","PRON|3MP",-1]],[["ٱل","P","DET|PREF|LEM:ال",-1],["رَّٰشِدُونَ","N","ACT_PCPL|VF:1|MP|NOM",4198]]]],["c'est là en effet une grâce d'Allah et un bienfait. Allah est Omniscient et Sage","",[[["فَضْلًا","N","M|INDEF|ACC",122]],[["مِّنَ","P","P",0]],[["ٱللَّهِ","N","PN|GEN",1]],[["وَ","P","CONJ|PREF|