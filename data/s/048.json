REM|PREF|LEM:ف",-1],["أَنزَلَ","V","PERF|VF:4|3MS",57]],[["ٱل","P","DET|PREF|LEM:ال",-1],["سَّكِينَةَ","N","F|ACC",1143]],[["عَلَيْ","P","P",8],["هِمْ","N","PRON|SUFF|3MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["أَثَٰبَ","V","PERF|VF:4|3MS",1770],["هُمْ","N","PRON|SUFF|3MP",-1]],[["فَتْحًا","N","M|INDEF|ACC",720]],[["قَرِيبًا","N","MS|INDEF|ACC|ADJ",401]]]],["ainsi qu'un abondant butin qu'ils ramasseront. Allah est Puissant et Sage","и многочисленными трофеями, которые они возьмут. Аллах - Могущественный, Мудрый",[[["وَ","P","CONJ|PREF|LEM:و",-1],["مَغَانِمَ","N","MP|ACC",1510]],[["كَثِيرَةً","N","FS|INDEF|ACC|ADJ",766]],[["يَأْخُذُ","V","IMPF|VF:1|3MP|MOOD:IND",87],["ونَ","N","PRON|SUFF|3MP",-1],["هَا","N","PRON|SUFF|3FS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["كَانَ","V","PERF|VF:1|FAM:كَان|3MS",9]],[["ٱللَّهُ","N","PN|NOM",1]],[["عَزِيزًا","N","MS|INDEF|ACC|ADJ",104]],[["حَكِيمًا","N","MS|INDEF|ACC|ADJ",106]]]],["Allah vous a promis un abondant butin que vous prendrez et Il a hâté pour vous Celle-ci et repoussé de vous les mains des gens, afin que tout cela soit un signe pour les croyants et qu'Il vous guide dans un droit chemin","Аллах обещал вам многочисленные трофеи, которые вы возьмете. Он ускорил для вас это и убрал от вас руки людей, чтобы это стало знамением для верующих и чтобы наставить вас на прямой путь",[[["وَعَدَ","V","PERF|VF:1|3MS",164],["كُمُ","N","PRON|SUFF|2MP",-1]],[["ٱللَّهُ","N","PN|NOM",1]],[["مَغَانِمَ","N","MP|ACC",1510]],[["كَثِيرَةً","N","FS|INDEF|ACC|ADJ",766]],[["تَأْخُذُ","V","IMPF|VF:1|2MP|MOOD:IND",87],["ونَ","N","PRON|SUFF|2MP",-1],["هَا","N","PRON|SUFF|3FS",-1]],[["فَ","P","CONJ|PREF|LEM:ف",-1],["عَجَّلَ","V","PERF|VF:2|3MS",1371]],[["لَ","P","P|PREF|LEM:ل",-1],["كُمْ","N","PRON|2MP",-1]],[["هَٰ","P","ATT|PREF|LEM:ه",-1],["ذِهِۦ","N","DEM|FS",10]],[["وَ","P","CONJ|PREF|LEM:و",-1],["كَفَّ","V","PERF|VF:1|3MS",972]],[["أَيْدِىَ","N","FP|ACC",92]],[["ٱل","P","DET|PREF|LEM:ال",-1],["نَّاسِ","N","MP|GEN",49]],[["عَن","P","P",20],["كُمْ