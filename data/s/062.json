UFF|2MP",-1]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["بَيْعَ","N","M|ACC",1039]],[["ذَٰ","N","DEM|MS",10],["لِ","P","DIST|SUFF|LEM:ل",-1],["كُمْ","P","ADDR|SUFF|MP",-1]],[["خَيْرٌ","N","MS|INDEF|NOM",58]],[["لَّ","P","P|PREF|LEM:ل",-1],["كُمْ","N","PRON|2MP",-1]],[["إِن","P","COND",15]],[["كُن","V","PERF|VF:1|FAM:كَان|2MP",9],["تُمْ","N","PRON|SUFF|2MP",-1]],[["تَعْلَمُ","V","IMPF|VF:1|2MP|MOOD:IND",25],["ونَ","N","PRON|SUFF|2MP",-1]]]],["Puis quand la Salât est achevée, dispersez-vous sur terre et recherchez [quelque effet] de la grâce d'Allah, et invoquez beaucoup Allah afin que vous réussissiez","Когда же намаз завершится, то разойдитесь по земле, ищите милость Аллаха и часто поминайте Его, - быть может, вы преуспеете",[[["فَ","P","REM|PREF|LEM:ف",-1],["إِذَا","N","T",23]],[["قُضِيَتِ","V","PERF|VF:1|PASS|3FS",189]],[["ٱل","P","DET|PREF|LEM:ال",-1],["صَّلَوٰةُ","N","F|NOM",124]],[["فَ","P","RSLT|PREF|LEM:ف",-1],["ٱنتَشِرُ","V","IMPV|VF:8|2MP",2040],["وا۟","N","PRON|SUFF|2MP",-1]],[["فِى","P","P",3]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["أَرْضِ","N","F|GEN",21]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱبْتَغُ","V","IMPV|VF:8|2MP",325],["وا۟","N","PRON|SUFF|2MP",-1]],[["مِن","P","P",0]],[["فَضْلِ","N","M|GEN",122]],[["ٱللَّهِ","N","PN|GEN",1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱذْكُرُ","V","IMPV|VF:1|2MP",121],["وا۟","N","PRON|SUFF|2MP",-1]],[["ٱللَّهَ","N","PN|ACC",1]],[["كَثِيرًا","N","MS|INDEF|ACC|ADJ",178]],[["لَّعَلَّ","P","ACC|FAM:إِنّ",85],["كُمْ","N","PRON|SUFF|2MP",-1]],[["تُفْلِحُ","V","IMPF|VF:4|2MP|MOOD:IND",387],["ونَ","N","PRON|SUFF|2MP",-1]]]],["Quand ils entrevoient quelque commerce ou quelque divertissement, ils s'y dispersent et te laissent debout. Dis: «Ce qui est auprès d'Allah est bien meilleur que le divertissement et le commerce, et Allah est le Meilleur des pourvoyeurs»","Когда же они увидели торговлю или забаву, они разошлись, бросившись к ней, и оставили тебя стоять во время пятничной проповеди. Скажи: «То, что у Аллаха, лучше забавы и торговли, и А