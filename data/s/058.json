3]],[["مِّن","P","P",0]],[["قَبْلِ","N","GEN",48]],[["أَن","P","SUB",17]],[["يَتَمَآسَّ","V","IMPF|VF:6|3MD|MOOD:SUBJ",2761],["ا","N","PRON|SUFF|3D",-1]],[["ذَٰ","N","DEM|MS",10],["لِ","P","DIST|SUFF|LEM:ل",-1],["كُمْ","P","ADDR|SUFF|MP",-1]],[["تُوعَظُ","V","IMPF|VF:1|PASS|2MP|MOOD:IND",606],["ونَ","N","PRON|SUFF|2MP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["هِۦ","N","PRON|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱللَّهُ","N","PN|NOM",1]],[["بِ","P","P|PREF|LEM:ب",-1],["مَا","N","REL",6]],[["تَعْمَلُ","V","IMPF|VF:1|2MP|MOOD:IND",41],["ونَ","N","PRON|SUFF|2MP",-1]],[["خَبِيرٌ","N","MS|INDEF|NOM",246]]]],["Mais celui qui n'en trouve pas les moyens doit jeûner alors deux mois consécutifs avant d'avoir aucun contact [conjugal] avec sa femme. Mais s'il ne peut le faire non plus, alors qu'il nourrisse soixante pauvres. Cela, pour que vous croyiez en Allah et en Son messager. Voilà les limites imposées par Allah. Et les mécréants auront un châtiment douloureux","Если кто-либо не сможет сделать этого, то он должен поститься в течение двух месяцев без перерыва прежде, чем они прикоснутся друг к другу. А кто не способен на это, тому надлежит накормить шестьдесят бедняков. Это делается для того, чтобы вы уверовали в Аллаха и Его Посланника. Таковы ограничения Аллаха, а для неверующих уготованы мучительные страдания",[[["فَ","P","REM|PREF|LEM:ف",-1],["مَن","N","REL",13]],[["لَّمْ","P","NEG",29]],[["يَجِدْ","V","IMPF|VF:1|3MS|MOOD:JUS",101]],[["فَ","P","REM|PREF|LEM:ف",-1],["صِيَامُ","N","M|NOM",875]],[["شَهْرَيْنِ","N","MD|GEN",471]],[["مُتَتَابِعَيْنِ","N","ACT_PCPL|VF:6|MD|GEN|ADJ",2237]],[["مِن","P","P",0]],[["قَبْلِ","N","GEN",48]],[["أَن","P","SUB",17]],[["يَتَمَآسَّ","V","IMPF|VF:6|3MD|MOOD:SUBJ",2761],["ا","N","PRON|SUFF|3D",-1]],[["فَ","P","REM|PREF|LEM:ف",-1],["مَن","N","REL",13]],[["لَّمْ","P","NEG",29]],[["يَسْتَطِعْ","V","IMPF|VF:10|3MS|MOOD:JUS",261]],[["فَ","P","REM|PREF|LEM:ف",-1],["إِطْعَامُ","N","VN|VF:4|M|NOM",1827]],[["سِتِّينَ","N","MP|GEN",4360]],[["مِسْكِينًا","N","MS|INDEF|ACC",438]],[["ذَٰ","N","DEM|MS",10],["لِ","P","DIST|SUFF|LEM:ل",-1],["كَ","P","ADDR|SUFF|M",-1]],[["لِ","P","PRP|PREF|LEM:ل",-1],["تُؤْمِنُ","V","IMPF|VF:4|2MP|MOOD:SUBJ",18],["وا۟","N","PRON|SUFF|2MP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["ٱللَّهِ","N","PN|GEN",1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["رَسُولِ","N","M|GEN",32],["هِۦ","N","PRON|SUFF|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["تِ","N","DEM|FS",10],["لْ","P","DIST|SUFF|LEM:ل",-1],["كَ","P","ADDR|SUFF|M",-1]],[["حُدُودُ","N","MP|NOM",636]],[["ٱللَّهِ","N","PN|GEN",1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["لِ","P","P|PREF|LEM:ل",-1],["لْ","P","DET|PREF|LEM:ال",-1],["كَٰفِرِينَ","N","ACT_PCPL|VF:1|MP|GEN",67]],[["عَذَابٌ","N","M|INDEF|NOM",33]],[["أَلِيمٌ","N","MS|INDEF|NOM|ADJ",151]]]],["Ceux qui s'opposent à Allah et à Son messager seront culbutés comme furent culbutés leurs devanciers. Nous avons déjà fait descendre des preuves explicites, et les mécréants auront un châtiment avilissant","Те, которые враждуют с Аллахом и Его Посланником, будут унижены, как были унижены их предшественники. Мы уже ниспослали ясные знамения, а для неверующих уготованы унизительные мучения",[[["إِنَّ","P","ACC|FAM:إِنّ",4]],[["ٱلَّذِينَ","N","REL|MP",7]],[["يُحَآدُّ","V","IMPF|VF:3|3MP|MOOD:IND",2762],["ونَ","N","PRON|SUFF|3MP",-1]],[["ٱللَّهَ","N","PN|ACC",1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["رَسُولَ","N","M|ACC",32],["هُۥ","N","PRON|SUFF|3MS",-1]],[["كُبِتُ","V","PERF|VF:1|PASS|3MP",1767],["وا۟","N","PRON|SUFF|3MP",-1]],[["كَ","P","P|PREF|LEM:ك",-1],["مَا","P","SUB",12]],[["كُبِتَ","V","PERF|VF:1|PASS|3MS",1767]],[["ٱلَّذِينَ","N","REL|MP",7]],[["مِن","P","P",0]],[["قَبْلِ","N","GEN",48],["هِمْ","N","PRON|SUFF|3MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["قَدْ","P","CERT",22]],[["أَنزَلْ","V","PERF|VF:4|1P",57],["نَآ","N","PRON|SUFF|1P",-1]],[["ءَايَٰتٍۭ","N","FP|INDEF|ACC",26]],[["بَيِّنَٰتٍ","N","FP|INDEF|ACC|ADJ",156]],[["وَ","P","CONJ|PREF|LEM:و",-1],["لِ","P","P|PREF|LEM:ل",-1],["لْ","P","DET|PREF|LEM:ال",-1],["كَٰفِرِينَ","N","ACT_PCPL|VF:1|MP|GEN",67]],[["عَذَابٌ","N","M|INDEF|NOM",33]],[["مُّهِينٌ","N","ACT_PCPL|VF:4|M|INDEF|NOM|ADJ",631]]]],["le jour où Allah les ressuscitera tous, puis les informera de ce qu'ils ont fait Allah l'a dénombré et ils l'auront oublié. Allah est témoin de toute chose","В тот день Аллах воскресит их всех и поведает им о том, что они совершили. Аллах исчислил это, а они забыли. Аллах - Свидетель всякой вещи",[[["يَوْمَ","N","M|ACC",19]],[["يَبْعَثُ","V","IMPF|VF:1|3MS|MOOD:IND",211],["هُمُ","N","PRON|SUFF|3MP",-1]],[["ٱللَّهُ","N","PN|NOM",1]],[["جَمِيعًا","N","M|INDEF|ACC",208]],[["فَ","P","CONJ|PREF|LEM:ف",-1],["يُنَبِّئُ","V","IMPF|VF:2|3MS|MOOD:IND",239],["هُم","N","PRON|SUFF|3MP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["مَا","N","REL",6]],[["عَمِلُ","V","PERF|VF:1|3MP",41],["وٓا۟","N","PRON|SUFF|3MP",-1]],[["أَحْصَىٰ","V","PERF|VF:4|3MS",850],["هُ","N","PRON|SUFF|3MS",-1]],[["ٱللَّهُ","N","PN|NOM",1]],[["وَ","P","CIRC|PREF|LEM:و",-1],["نَسُ","V","PERF|VF:1|3MP",316],["و","N","PRON|SUFF|3MP",-1],["هُ","N","PRON|SUFF|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱللَّهُ","N","PN|NOM",1]],[["عَلَىٰ","P","P",8]],[["كُلِّ","N","M|GEN",28]],[["شَىْءٍ","N","M|INDEF|GEN",38]],[["شَهِيدٌ","N","MS|INDEF|NOM|ADJ",198]]]],["Ne vois-tu pas qu'Allah sait ce qui est dans les cieux et sur la terre? Pas de conversation secrète entre trois sans qu'Il ne soit leur quatrième, ni entre cinq sans qu'Il n'y ne soit leur sixième, ni moins ni plus que cela sans qu'Il ne soit avec eux, là où ils se trouvent. Ensuite, Il les informera au Jour de la Résurrection, de ce qu'ils faisaient, car Allah est Omniscient","Разве ты не знаешь, что Аллаху ведомо то, что на небесах, и то, что на земле? Не бывает тайной беседы между тремя, чтобы Он не был четвертым; или между пятью, чтобы Он не был шестым. Больше их или меньше - Он всегда с ними, где бы они ни были. А потом, в День воскресения, Он поведает им о том, что они совершили. Воистину, Аллах знает о всякой вещи",[[["أَ","N","INTG|PREF|LEM:أ",-1],["لَمْ","P","NEG",29]],[["تَرَ","V","IMPF|VF:1|2MS|MOOD:JUS",43]],[["أَنَّ","P","ACC|FAM:إِنّ",27]],[["ٱللَّهَ","N","PN|ACC",1]],[["يَعْلَمُ","V","IMPF|VF:1|3MS|MOOD:IND",25]],[["مَا","N","REL",6]],[["فِى","P","P",3]],[["ٱل","P","DET|PREF|LEM:ال",-1],["سَّمَٰوَٰتِ","N","FP|GEN",34]],[["وَ","P","CONJ|PREF|LEM:و",-1],["مَا","N","REL",6]],[["فِى","P","P",3]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["أَرْضِ","N","F|GEN",21]],[["مَا","P","NEG",12]],[["يَكُونُ","V","IMPF|VF:1|FAM:كَان|3MS|MOOD:IND",9]],[["مِن","P","P",0]],[["نَّجْوَىٰ","N","M|GEN",775]],[["ثَلَٰثَةٍ","N","F|INDEF|GEN",663]],[["إِلَّا","P","RES",16]],[["هُوَ","N","PRON|3MS",-1]],[["رَابِعُ","N","M|NOM",2504],["هُمْ","N","PRON|SUFF|3MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["لَا","P","NEG",2]],[["خَمْسَةٍ","N","F|INDEF|GEN",1766]],[["إِلَّا","P","RES",16]],[["هُوَ","N","PRON|3MS",-1]],[["سَادِسُ","N","M|NOM",2505],["هُمْ","N","PRON|SUFF|3MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["لَآ","P","NEG",2]],[["أَدْنَىٰ","N","MS|GEN",690]],[["مِن","P","P",0]],[["ذَٰ","N","DEM|MS",10],["لِ","P","DIST|SUFF|LEM:ل",-1],["كَ","P","ADDR|SUFF|M",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["لَآ","P","NEG",2]],[["أَكْثَرَ","N","MS|ACC",130]],[["إِلَّا","P","RES",16]],[["هُوَ","N","PRON|3MS",-1]],[["مَعَ","N","LOC|ACC",64],["هُمْ","N","PRON|SUFF|3MP",-1]],[["أَيْنَ","N","LOC",505]],[["مَا","N","REL",6]],[["كَانُ","V","PERF|VF:1|FAM:كَان|3MP",9],["وا۟","N","PRON|SUFF|3MP",-1]],[["ثُمَّ","P","CONJ",31]],[["يُنَبِّئُ","V","IMPF|VF:2|3MS|MOOD:IND",239],["هُم","N","PRON|SUFF|3MP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["مَا","N","REL",6]],[["عَمِلُ","V","PERF|VF:1|3MP",41],["وا۟","N","PRON|SUFF|3MP",-1]],[["يَوْمَ","N","M|ACC",19]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["قِيَٰمَةِ","N","F|GEN",161]],[["إِنَّ","P","ACC|FAM:إِنّ",4]],[["ٱللَّهَ","N","PN|ACC",1]],[["بِ","P","P|PREF|LEM:ب",-1],["كُلِّ","N","M|GEN",28]],[["شَىْءٍ","N","M|INDEF|GEN",38]],[["عَلِيمٌ","N","MS|INDEF|NOM|ADJ",65]]]],["Ne vois-tu pas ceux à qui les conversations secrètes ont été interdites? Puis, ils retournent à ce qui leur a été interdit, et se concertent pour pécher, transgresser et désobéir au Messager. Et quand ils viennent à toi, ils te saluent d'une façon dont Allah ne t'a pas salué, et disent en eux-mêmes: «Pourquoi Allah ne nous châtie pas pour ce que nous disons?» L'Enfer leur suffira, où ils brûleront. Et quelle mauvaise destination","Разве ты не видел тех, кому были запрещены тайные беседы. Они возвращаются к тому, что было им запрещено, и тайно переговариваются о грехах, посягательстве и неповиновении Посланнику. Когда они приходят к тебе, то приветствуют тебя не так, как приветствует тебя Аллах, говоря в душе: «Почему бы Аллаху не наказать нас за то, что мы говорим?». Довольно с них Геенны! Туда они попадут, и как же скверно это место прибытия",[[["أَ","N","INTG|PREF|LEM:أ",-1],["لَمْ","P","NEG",29]],[["تَرَ","V","IMPF|VF:1|2MS|MOOD:JUS",43]],[["إِلَى","P","P",14]],[["ٱلَّذِينَ","N","REL|MP",7]],[["نُهُ","V","PERF|VF:1|PASS|3MP",339],["وا۟","N","PRON|SUFF|3MP",-1]],[["عَنِ","P","P",20]],[["ٱل","P","DET|PREF|LEM:ال",-1],["نَّجْوَىٰ","N","M|GEN",775]],[["ثُمَّ","P","CONJ",31]],[["يَعُودُ","V","IMPF|VF:1|3MP|MOOD:IND",528],["ونَ","N","PRON|SUFF|3MP",-1]],[["لِ","P","P|PREF|LEM:ل",-1],["مَا","N","REL",6]],[["نُهُ","V","PERF|VF:1|PASS|3MP",339],["وا۟","N","PRON|SUFF|3MP",-1]],[["عَنْ","P","P",20],["هُ","N","PRON|SUFF|3MS",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["يَتَنَٰجَ","V","IMPF|VF:6|3MP|MOOD:IND",1671],["وْنَ","N","PRON|SUFF|3MP",-1]],[["بِ","P","P|PREF|LEM:ب",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["إِثْمِ","N","M|GEN",318]],[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱلْ","P","DET|PREF|LEM:ال",-1],["عُدْوَٰنِ","N","M|GEN",937]],[["وَ","P","CONJ|PREF|LEM:و",-1],["مَعْصِيَتِ","N","F|GEN",2763]],[["ٱل","P","DET|PREF|LEM:ال",-1],["رَّسُولِ","N","M|GEN",32]],[["وَ","P","CONJ|PREF|LEM:و",-1],["إِذَا","N","T",23]],[["جَآءُ","V","PERF|VF:1|3MP",40],["و","N","PRON|SUFF|3MP",-1],["كَ","N","PRON|SUFF|2M