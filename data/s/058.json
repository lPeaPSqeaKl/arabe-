"N","PN|GEN",1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["عَلَى","P","P",8]],[["ٱللَّهِ","N","PN|GEN",1]],[["فَ","P","REM|PREF|LEM:ف",-1],["لْ","P","IMPV|PREF|LEM:ل",-1],["يَتَوَكَّلِ","V","IMPF|VF:5|3MS|MOOD:JUS",281]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["مُؤْمِنُونَ","N","ACT_PCPL|VF:4|MP|NOM",52]]]],["O vous qui avez cru! Quand on vous dit: «Faites place [aux autres] dans les assemblées», alors faites place. Allah vous ménagera une place (au Paradis). Et quand on vous dit de vous lever, levez-vous. Allah élèvera en degrés ceux d'entre vous qui auront cru et ceux qui auront reçu le savoir. Allah est Parfaitement Connaisseur de ce que vous faites","О те, которые уверовали! Когда вас просят на собраниях сесть пошире, то садитесь пошире, и Аллах одарит вас местом просторным. Когда же вам велят подняться, то поднимайтесь. Аллах возвышает по степеням тех из вас, кто уверовал, и тех, кому даровано знание. Аллах ведает о том, что вы совершаете",[[["يَٰٓ","P","VOC|PREF|LEM:ي",-1],["أَيُّ","N","ACC",51],["هَا","P","ATT|SUFF|LEM:ه",-1]],[["ٱلَّذِينَ","N","REL|MP",7]],[["ءَامَنُ","V","PERF|VF:4|3MP",18],["وٓا۟","N","PRON|SUFF|3MP",-1]],[["إِذَا","N","T",23]],[["قِيلَ","V","PERF|VF:1|PASS|3MS",5]],[["لَ","P","P|PREF|LEM:ل",-1],["كُمْ","N","PRON|2MP",-1]],[["تَفَسَّحُ","V","IMPV|VF:5|2MP",4361],["وا۟","N","PRON|SUFF|2MP",-1]],[["فِى","P","P",3]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["مَجَٰلِسِ","N","MP|GEN",4362]],[["فَ","P","REM|PREF|LEM:ف",-1],["ٱفْسَحُ","V","IMPV|VF:1|2MP",2764],["وا۟","N","PRON|SUFF|2MP",-1]],[["يَفْسَحِ","V","IMPF|VF:1|3MS|MOOD:JUS",2764]],[["ٱللَّهُ","N","PN|NOM",1]],[["لَ","P","P|PREF|LEM:ل",-1],["كُمْ","N","PRON|2MP",-1]],[["وَ","P","CONJ|PREF|LEM:و",-1],["إِذَا","N","T",23]],[["قِيلَ","V","PERF|VF:1|PASS|3MS",5]],[["ٱنشُزُ","V","IMPV|VF:1|2MP",2765],["وا۟","N","PRON|SUFF|2MP",-1]],[["فَ","P","REM|PREF|LEM:ف",-1],["ٱنشُزُ","V","IMPV|VF:1|2MP",2765],["وا۟","N","PRON|SUFF|2MP",-1]],[["يَرْفَعِ","V","IMPF|VF:1|3MS|MOOD:JUS",446]],[["ٱللَّهُ","N","PN|NOM",1]],[["ٱلّ