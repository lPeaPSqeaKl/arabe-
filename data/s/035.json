,"P",3],["هَا","N","PRON|SUFF|3FS",-1]],[["حَرِيرٌ","N","M|INDEF|NOM",2014]]]],["Et ils diront: «Louange à Allah qui a écarté de nous l'affliction. Notre Seigneur est certes Pardonneur et Reconnaissant","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["قَالُ","V","PERF|VF:1|3MP",5],["وا۟","N","PRON|SUFF|3MP",-1]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["حَمْدُ","N","M|NOM",254]],[["لِ","P","P|PREF|LEM:ل",-1],["لَّهِ","N","PN|GEN",1]],[["ٱلَّذِىٓ","N","REL|MS",7]],[["أَذْهَبَ","V","PERF|VF:4|3MS",776]],[["عَنَّ","P","P",20],["ا","N","PRON|SUFF|1P",-1]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["حَزَنَ","N","M|ACC",1905]],[["إِنَّ","P","ACC|FAM:إِنّ",4]],[["رَبَّ","N","M|ACC",11],["نَا","N","PRON|SUFF|1P",-1]],[["لَ","P","EMPH|PREF|LEM:ل",-1],["غَفُورٌ","N","MS|INDEF|NOM",111]],[["شَكُورٌ","N","MS|INDEF|NOM|ADJ",849]]]],["C'est Lui qui nous a installés, par Sa grâce, dans la Demeure de la stabilité, où nulle fatigue, nulle lassitude ne nous touchent»","",[[["ٱلَّذِىٓ","N","REL|MS",7]],[["أَحَلَّ","V","PERF|VF:4|3MS",488],["نَا","N","PRON|SUFF|1P",-1]],[["دَارَ","N","FS|ACC",233]],[["ٱلْ","P","DET|PREF|LEM:ال",-1],["مُقَامَةِ","N","PASS_PCPL|VF:4|F|GEN",4002]],[["مِن","P","P",0]],[["فَضْلِ","N","M|GEN",122],["هِۦ","N","PRON|SUFF|3MS",-1]],[["لَا","P","NEG",2]],[["يَمَسُّ","V","IMPF|VF:1|3MS|MOOD:IND",199],["نَا","N","PRON|SUFF|1P",-1]],[["فِي","P","P",3],["هَا","N","PRON|SUFF|3FS",-1]],[["نَصَبٌ","N","M|INDEF|NOM",1579]],[["وَ","P","CONJ|PREF|LEM:و",-1],["لَا","P","NEG",2]],[["يَمَسُّ","V","IMPF|VF:1|3MS|MOOD:IND",199],["نَا","N","PRON|SUFF|1P",-1]],[["فِي","P","P",3],["هَا","N","PRON|SUFF|3FS",-1]],[["لُغُوبٌ","N","M|INDEF|NOM",2672]]]],["Et ceux qui ont mécru auront le feu de l'Enfer: on ne les achève pas pour qu'ils meurent; on ne leur allège rien de ses tourments. C'est ainsi que Nous récompensons tout négateur obstiné","",[[["وَ","P","CONJ|PREF|LEM:و",-1],["ٱلَّذِينَ","N","REL|MP",7]],[["كَفَرُ","V","PERF|VF:1|3MP",37],["وا۟","N","PRON|SUFF|3MP",-1]],[["لَ","P","P|PREF|LEM:ل",-1],["هُمْ